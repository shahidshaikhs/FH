<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="brand-values spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="brand-values__items">
      {% for block in section.blocks %}
        <div class="brand-values__item" {{ block.shopify_attributes }}>
          {% if block.settings.svg_filename != blank %}
            <div class="brand-values__icon">
              <img
                src="{{ block.settings.svg_filename | asset_url }}"
                alt=""
                width="48"
                height="48"
                loading="lazy"
              >
            </div>
          {% endif %}
          {% if block.settings.label != blank %}
            <span class="brand-values__label">{{ block.settings.label | escape }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="brand-values__divider"></div>
  </div>
</div>

{% stylesheet %}
  .brand-values {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .brand-values__items {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 64px;
  }

  .brand-values__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .brand-values__icon img {
    display: block;
    width: 48px;
    height: 48px;
  }

  .brand-values__label {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.48px;
    color: var(--color-foreground);
    text-align: center;
  }

  .brand-values__divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-border);
  }

  @media screen and (max-width: 749px) {
    .brand-values__items {
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
    }

    .brand-values__item {
      width: 140px;
      gap: 8px;
    }

    .brand-values__icon img {
      width: 32px;
      height: 32px;
    }

    .brand-values__label {
      font-size: 18px;
      line-height: 28px;
      letter-spacing: -0.36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand values",
  "tag": "section",
  "class": "brand-values-wrapper section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "svg_filename",
          "label": "SVG filename",
          "info": "Name of the SVG file in theme assets (e.g. soft.svg)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "settings": {
        "color_scheme": "scheme-2",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 0
      },
      "blocks": [
        {
          "type": "value",
          "settings": {
            "svg_filename": "soft.svg",
            "label": "Signature Comfort"
          }
        },
        {
          "type": "value",
          "settings": {
            "svg_filename": "ocean.svg",
            "label": "Elevated Coastal Essentials"
          }
        },
        {
          "type": "value",
          "settings": {
            "svg_filename": "sustainable.svg",
            "label": "Made by the Elements"
          }
        },
        {
          "type": "value",
          "settings": {
            "svg_filename": "shorts.svg",
            "label": "Effortless Versatility"
          }
        }
      ]
    }
  ]
}
{% endschema %}
