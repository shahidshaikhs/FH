{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
%}

<div
  class="gallery-collage color-{{ section.settings.color_scheme }}"
  data-testid="gallery-collage"
>
  <div
    class="gallery-collage__container spacing-style section section--full-width"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- comment -%} Desktop layout (≥750px) {%- endcomment -%}
    <div class="gallery-collage__layout gallery-collage__layout--desktop" data-testid="gallery-collage-desktop">
      <div class="gallery-collage__content">
        {% if heading != blank %}
          <h2 class="gallery-collage__heading">{{ heading | escape }}</h2>
        {% endif %}
        {% if description != blank %}
          <div class="gallery-collage__description">{{ description }}</div>
        {% endif %}
      </div>

      <div class="gallery-collage__grid">
        <div class="gallery-collage__column gallery-collage__column--1">
          {% if section.settings.image_1 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--landscape">
              {% render 'image', image: section.settings.image_1, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
          {% if section.settings.image_2 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_2, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>

        <div class="gallery-collage__column gallery-collage__column--2">
          {% if section.settings.image_3 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_3, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>

        <div class="gallery-collage__column gallery-collage__column--3">
          {% if section.settings.image_4 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_4, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
          {% if section.settings.image_5 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--landscape">
              {% render 'image', image: section.settings.image_5, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {%- comment -%} Mobile layout (<750px) {%- endcomment -%}
    <div class="gallery-collage__layout gallery-collage__layout--mobile" data-testid="gallery-collage-mobile">
      <div class="gallery-collage__content gallery-collage__content--mobile">
        {% if heading != blank %}
          <h2 class="gallery-collage__heading gallery-collage__heading--mobile">{{ heading | escape }}</h2>
        {% endif %}
        {% if description != blank %}
          <div class="gallery-collage__description gallery-collage__description--mobile">{{ description }}</div>
        {% endif %}
      </div>

      <div class="gallery-collage__grid gallery-collage__grid--mobile">
        <div class="gallery-collage__column gallery-collage__column-mobile--1">
          {% if section.settings.image_2 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_2, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>

        <div class="gallery-collage__column gallery-collage__column-mobile--2">
          {% if section.settings.image_1 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--landscape">
              {% render 'image', image: section.settings.image_1, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
          {% if section.settings.image_3 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_3, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>

        <div class="gallery-collage__column gallery-collage__column-mobile--3">
          {% if section.settings.image_4 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--portrait">
              {% render 'image', image: section.settings.image_4, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
          {% if section.settings.image_5 != blank %}
            <div class="gallery-collage__image-wrap gallery-collage__image-wrap--landscape">
              {% render 'image', image: section.settings.image_5, class: 'gallery-collage__image' %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* Gallery Collage Section */
  .gallery-collage {
    overflow: hidden;
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  /* Desktop layout — visible ≥750px, hidden below */
  .gallery-collage__layout--desktop {
    display: flex;
    gap: 48px;
    justify-content: center;
    align-items: center;
    padding-inline: 64px;
  }

  .gallery-collage__layout--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .gallery-collage__layout--desktop {
      display: none;
    }

    .gallery-collage__layout--mobile {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
  }

  /* Content area */
  .gallery-collage__content {
    flex-shrink: 0;
    max-width: 408px;
  }

  .gallery-collage__heading {
    font-family: var(--font-heading--family);
    font-size: 32px;
    line-height: 40px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
    margin: 0 0 8px;
  }

  .gallery-collage__description {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
  }

  .gallery-collage__description p {
    margin: 0;
  }

  .gallery-collage__description p + p {
    margin-block-start: 1em;
  }

  /* Desktop image grid */
  .gallery-collage__grid {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  .gallery-collage__column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    min-width: 0;
  }

  .gallery-collage__column--1 {
    justify-content: flex-end;
  }

  .gallery-collage__column--2 {
    padding-block-start: 112px;
    justify-content: flex-start;
  }

  .gallery-collage__column--3 {
    padding-block-end: 64px;
    justify-content: flex-start;
  }

  /* Image containers with aspect ratios */
  .gallery-collage__image-wrap {
    width: 100%;
    overflow: hidden;
  }

  .gallery-collage__image-wrap--portrait {
    aspect-ratio: 307 / 480;
  }

  .gallery-collage__image-wrap--landscape {
    aspect-ratio: 307 / 196;
  }

  .gallery-collage__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile content */
  @media screen and (max-width: 749px) {
    .gallery-collage__content--mobile {
      text-align: center;
      padding: 24px 16px;
      max-width: none;
    }

    .gallery-collage__heading--mobile {
      font-size: 24px;
      line-height: 32px;
    }

    .gallery-collage__description--mobile {
      text-align: center;
    }

    /* Mobile image grid */
    .gallery-collage__grid--mobile {
      display: flex;
      gap: 8px;
      justify-content: center;
      padding: 24px 0;
    }

    .gallery-collage__column-mobile--1,
    .gallery-collage__column-mobile--2,
    .gallery-collage__column-mobile--3 {
      display: flex;
      flex-direction: column;
      flex: 0 0 44vw;
      min-width: 0;
    }

    .gallery-collage__column-mobile--1 {
      gap: 32px;
      justify-content: center;
    }

    .gallery-collage__column-mobile--2 {
      gap: 8px;
      padding-block-start: 24px;
    }

    .gallery-collage__column-mobile--3 {
      gap: 8px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery collage",
  "tag": "section",
  "class": "gallery-collage-wrapper section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Protect The Places You Love"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Fair Harbor channels the laid-back spirit of coastal living into comfortable, versatile essentials made for life in motion. What began as sustainable swimwear has grown into a full collection of year-round staples—crafted from recycled bottles and other eco-friendly fabrics.</p><p>Since launch, the Certified B Corp has repurposed over 37 million bottles and is now carried online and in 400+ retailers nationwide.</p>"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (landscape)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (portrait)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (portrait)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4 (portrait)"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5 (landscape)"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "page-width",
          "label": "Page width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Gallery collage"
    }
  ]
}
{% endschema %}
