{% doc %}
  In-Grid Promotional Banner

  Renders a promotional banner card within the product grid.
  Displays a background image with gradient overlay, heading,
  description, and underlined link. All text is white.

  @param {object} image - Shopify image object
  @param {string} heading - Banner heading text
  @param {string} description - Banner description text
  @param {string} link_text - Link label (default: 'Shop now')
  @param {string} link_url - Link destination URL
  @param {string} [shopify_attributes] - Block shopify_attributes for theme editor
{% enddoc %}

{% liquid
  assign heading = heading | default: ''
  assign description = description | default: ''
  assign link_text = link_text | default: 'Shop now'
  assign link_url = link_url | default: '#'
  assign shopify_attributes = shopify_attributes | default: ''
%}

<div class="collection-in-grid-banner" {{ shopify_attributes }}>
  {% if image != blank %}
    <div class="collection-in-grid-banner__media">
      {{
        image
        | image_url: width: image.width
        | image_tag:
          sizes: '(min-width: 750px) 340px, 164px',
          widths: '164,328,340,680',
          loading: 'lazy',
          class: 'collection-in-grid-banner__image',
          alt: heading
      }}
    </div>
  {% endif %}
  <div class="collection-in-grid-banner__overlay"></div>
  <div class="collection-in-grid-banner__content">
    {% if heading != blank %}
      <h3 class="collection-in-grid-banner__heading">{{ heading | escape }}</h3>
    {% endif %}
    {% if description != blank %}
      <p class="collection-in-grid-banner__description">{{ description | escape }}</p>
    {% endif %}
    {% if link_text != blank %}
      <a href="{{ link_url }}" class="collection-in-grid-banner__link">{{ link_text | escape }}</a>
    {% endif %}
  </div>
</div>
